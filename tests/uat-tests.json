{
  "info": {
    "name": "GotSpot UAT Tests",
    "description": "User Acceptance Testing for GotSpot API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{api_url}}/health",
          "host": ["{{api_url}}"],
          "path": ["health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response has status OK', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql('OK');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Parking Spots",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{api_url}}/api/parking/spots?lat=54.3520&lng=18.6466&radius=1000",
          "host": ["{{api_url}}"],
          "path": ["api", "parking", "spots"],
          "query": [
            {
              "key": "lat",
              "value": "54.3520"
            },
            {
              "key": "lng",
              "value": "18.6466"
            },
            {
              "key": "radius",
              "value": "1000"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response is an array', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array');",
              "});",
              "",
              "pm.test('Has parking spots', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.length).to.be.greaterThan(0);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Search Parking Spots",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{api_url}}/api/parking/search?query=Gdansk&lat=54.3520&lng=18.6466",
          "host": ["{{api_url}}"],
          "path": ["api", "parking", "search"],
          "query": [
            {
              "key": "query",
              "value": "Gdansk"
            },
            {
              "key": "lat",
              "value": "54.3520"
            },
            {
              "key": "lng",
              "value": "18.6466"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response is an array', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
